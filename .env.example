# Frontend build-time setting; copy to .env.local for Next.js.
NEXT_PUBLIC_MULTIPLAYER_URL=http://localhost:4001
# The separate server reads its process environment, not Next.js .env.local.
# Export these when starting the server if you need to override local defaults:
# MULTIPLAYER_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# MULTIPLAYER_HOST=127.0.0.1
# MULTIPLAYER_PORT=4001

# Host streaming is enabled by default on the separate room server.
# MULTIPLAYER_STREAMING=false
# Optional frontend build-time WebRTC ICE configuration for other networks:
# NEXT_PUBLIC_RTC_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:relay.example.com:3478","username":"guest","credential":"replace-me"}]'

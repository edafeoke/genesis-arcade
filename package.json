{
  "name": "genesis-arcade",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lab:build": "python3 scripts/build-lab-core.py && node scripts/build-adapter-proof.mjs",
    "dev": "node scripts/prepare-online.mjs && next dev",
    "build": "node scripts/prepare-online.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "postbuild": "node scripts/build-offline.mjs",
    "build:webpack": "node scripts/prepare-online.mjs && next build --webpack && node scripts/build-offline.mjs",
    "test": "node --test scripts/*.test.mjs && node --import tsx --test server/*.test.ts",
    "server:dev": "tsx watch server/index.ts",
    "server:build": "tsc -p server/tsconfig.json",
    "server:start": "node .multiplayer-build/server/index.js",
    "check:multiplayer": "node scripts/check-multiplayer.mjs",
    "test:multiplayer": "node --import tsx --test server/*.test.ts",
    "test:sync": "node --import tsx --test server/adapter.test.ts server/fixture-backend.test.ts server/lockstep.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.0",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.25.0"
}
